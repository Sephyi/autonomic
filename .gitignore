# --- Rust Project .gitignore -------------------------------------------------
# Cross-platform ignore rules for Rust binary crates.
#
# Structure:
#   Rust / Cargo, AI Models, Editors & IDEs, AI Tooling,
#   macOS, Windows, Linux
#
# Sources:
#   https://github.com/github/gitignore/blob/main/Rust.gitignore
#   https://github.com/github/gitignore/tree/main/Global
#
# Note: OS and editor patterns are included in-repo for contributor safety.
#   For personal machines, consider a global gitignore instead:
#   git config --global core.excludesfile ~/.config/git/ignore
# -----------------------------------------------------------------------------

# --- Rust / Cargo ------------------------------------------------------------
# Compiled output (debug + release builds, all targets).
# Intentionally without trailing slash to also catch symlinks/files named this.

debug
target

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these (debug symbols)
*.pdb

# cargo-mutants output (mutation testing data)
**/mutants.out*/

# cargo-fuzz corpus & artifacts
fuzz/corpus/
fuzz/artifacts/

# Cargo.lock is committed for binary crates (executables).
# If this were a library crate, you'd ignore it:
# Cargo.lock

# --- AI Models ---------------------------------------------------------------
# Large binary model files. Never commit these — use Git LFS or a model
# registry instead.

models/

# --- Editors & IDEs ----------------------------------------------------------

# VS Code — ignore workspace settings but keep shared extension recommendations
.vscode/
!.vscode/extensions.json

# JetBrains IDEs (RustRover, IntelliJ, CLion, etc.)
# https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
.idea/
*.iml

# Vim / Neovim
*.swp
*.swo
*~.nib
Session.vim
.netrwhist
tags

# Emacs
\#*\#
.#*

# Zed
.zed/

# --- Infrastructure Secrets ---------------------------------------------------

# Postgres password and other secrets (never commit)
infra/secrets/

# --- AI Tooling --------------------------------------------------------------

# Claude Code worktrees (managed by claude)
.claude/worktrees/

# GitHub Copilot
.copilot/

# Aider
.aider*

# --- macOS -------------------------------------------------------------------
# https://github.com/github/gitignore/blob/main/Global/macOS.gitignore

# General
.DS_Store
__MACOSX/
.AppleDouble
.LSOverride

# Icon must end with two \r (encoded as Icon\r\r in the file)
Icon

# Thumbnails
._*

# Volume root metadata
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# AFP share artifacts
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# --- Windows -----------------------------------------------------------------
# https://github.com/github/gitignore/blob/main/Global/Windows.gitignore

# Thumbnail caches
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Dump files
*.stackdump

# Folder configuration
[Dd]esktop.ini

# Recycle Bin on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# Shortcuts
*.lnk

# --- Linux -------------------------------------------------------------------
# https://github.com/github/gitignore/blob/main/Global/Linux.gitignore

# Backup files (editors, tilde convention)
*~

# Temporary files from deleted-but-open handles
.fuse_hidden*

# KDE Dolphin metadata
.directory

# Trash directories on mounted volumes
.Trash-*

# NFS lock/temp files
.nfs*

# nohup default log
nohup.out
